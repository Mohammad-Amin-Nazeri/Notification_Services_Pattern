<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>NotificationServices.Kit</PackageId>
    <Version>2.0.1</Version>
    <Authors>Mohammad Amin Nazeri</Authors>
    <Description>Unified Email and SMS notification services for .NET with provider-independent configuration.</Description>
    <PackageTags>dotnet;csharp;notification;email;sms;otp;dependency-injection;configuration;provider</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Mohammad-Amin-Nazeri/Notification_Services_Pattern</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Email\NotificationServices.Email\NotificationServices.Email.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\Sms\NotificationServices.Sms\NotificationServices.Sms.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="LICENSE" />
  </ItemGroup>

  <Target Name="IncludeNotificationAssembliesInPackage" BeforeTargets="Pack">
    <ItemGroup>
      <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\NotificationServices.Email.dll" />
      <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\NotificationServices.Email.Abstractions.dll" />
      <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\NotificationServices.Sms.dll" />
      <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\NotificationServices.Sms.Abstractions.dll" />
    </ItemGroup>
  </Target>
</Project>
